# RUNTIME
PYTHON_VERSION = 3.11.15

# LLM (Google Gemini, Groq, OpenAI, or Anthropic)
# GEMINI_API_KEY=your_gemini_api_key_here
# CREW_LLM_MODEL=gemini/gemini-2.5-flash
GROQ_API_KEY=gsk_your_actual_key_here
CREW_LLM_MODEL=groq/llama-3.1-8b-instant
# or gemini/gemini-2.5-flash, gemini/gemini-1.5-flash, gpt-4o-mini, or claude-3-5-sonnet-20241022

# Auth
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./fitness.db

# External tool APIs
EXERCISEDB_API_KEY=your-rapidapi-exercisedb-key
SPOONACULAR_API_KEY=your-spoonacular-key
RESEND_API_KEY=your-resend-api-key
NOTIFICATION_FROM_EMAIL=onboarding@resend.dev

# Vector store (for RAG safety-check agent)
CHROMA_PERSIST_DIR=./chroma_store
